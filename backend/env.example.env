# ==== Database ====
DB_USER=postgres
DB_PASSWORD=replace_with_a_long_random_password
DB_NAME=postgres
# Для запуска Python с хоста (Docker пробрасывает 5433 -> 5432):
DB_HOST=localhost
DB_PORT=5433

# ==== Redis ====
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0

# ==== ML ====
ML_SERVICE_URL=http://localhost:8002

# ==== NDTP ====
NDTP_TCP_PORT=9201

# ==== Security ====
API_TOKEN=replace_with_long_random_token_no_cyrillic
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==== Debug (включить на время отладки) ====
DEBUG_LOG_FEATURES=0
DEBUG_SAVE_FEATURES=0
DEBUG_LOG_MODEL=0